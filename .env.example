# Which LLM provider to use: "azure" or "openai"
LLM_PROVIDER=azure

# Azure OpenAI (Microsoft Foundry)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI API (only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 0 for gpt-4o-mini. Leave EMPTY for gpt-5 family models (they reject temperature).
LLM_TEMPERATURE=0
# Only for gpt-5 family: minimal / low / medium. Leave EMPTY for gpt-4o-mini.
LLM_REASONING_EFFORT=

# List prices in USD per 1M tokens, used for cost estimates (gpt-5-mini defaults)
LLM_PRICE_INPUT_PER_M=0.25
LLM_PRICE_OUTPUT_PER_M=2.00

# GitHub fine-grained token (scoped to the textutils repo only)
GITHUB_TOKEN=

# Where the agent clones the target repo
WORKSPACE_DIR=./workspace